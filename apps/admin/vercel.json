{
  "buildCommand": "cd ../.. && pnpm --filter @carrymate/db run build && pnpm --filter @carrymate/admin run build",
  "outputDirectory": ".next",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/trpc/:path*",
      "destination": "https://api.carrymate.io/api/trpc/:path*"
    }
  ]
}
