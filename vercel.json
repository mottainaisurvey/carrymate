{
  "buildCommand": "pnpm --filter @carrymate/web run build",
  "outputDirectory": "apps/web/.next",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "rewrites": [
    {
      "source": "/api/trpc/:path*",
      "destination": "https://api.carrymate.io/api/trpc/:path*"
    }
  ]
}
